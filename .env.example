# --- Risk defaults (see app/core/risk.py for full logic) ---
RISK_PER_TRADE_PCT=0.75
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
MIN_RISK_REWARD=2.0
MINIMUM_ENTRY_SCORE=80

# --- Trading mode & auto-execution (SAFE DEFAULTS - do not change lightly) ---
DEFAULT_GLOBAL_TRADING_MODE=ALERT_MODE
DEFAULT_AUTO_TRADING_ENABLED=false
DEFAULT_PAPER_TRADING_ENABLED=true
BROKER_ADAPTER=paper
MAX_ALLOWED_SLIPPAGE_PIPS=2.0
APPROVAL_EXPIRY_SECONDS=60
AUTO_EXECUTION_MINIMUM_SCORE=80
AUTO_EXECUTION_MIN_RISK_REWARD=2.0
MAX_DRAWDOWN_PCT=8.0

# --- Notification engine ---
NOTIFICATION_MAX_RETRIES=2
NOTIFICATION_FALLBACK_ENABLED=true
