# --- App ---
ENVIRONMENT=development
API_SECRET_KEY=change-me
TRADINGVIEW_WEBHOOK_SECRET=change-me

# --- Database (Supabase) ---
# Get these from: Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Use the SESSION POOLER (port 5432) for DATABASE_URL (the app's async engine) --
# it supports prepared statements, which asyncpg relies on.
# Use the SESSION POOLER or DIRECT CONNECTION (also 5432, different host) for
# DATABASE_URL_SYNC (Alembic migrations) -- psycopg2 works fine with either.
# Avoid the TRANSACTION POOLER (port 6543) unless you also set
# DATABASE_USE_PGBOUNCER=true below.
#
# Example (replace [PROJECT-REF], [PASSWORD], [REGION] with your actual values):
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USE_PGBOUNCER=false
DATABASE_SSL_REQUIRED=true

# --- Redis / Celery ---
# redis-cli --tls -u redis://default:gQAAAAAAA1E-AAIgcDFiZGM4YTk0MDljZmY0ODJhOGY0N2FjZjM5ZmZiYzAzNw@master-bluegill-217406.upstash.io:6379
REDIS_URL=redis://default:gQAAAAAAA1E-AAIgcDFiZGM4YTk0MDljZmY0ODJhOGY0N2FjZjM5ZmZiYzAzNw@master-bluegill-217406.upstash.io:6379/0
CELERY_BROKER_URL=redis://default:gQAAAAAAA1E-AAIgcDFiZGM4YTk0MDljZmY0ODJhOGY0N2FjZjM5ZmZiYzAzNw@master-bluegill-217406.upstash.io:6379/0

